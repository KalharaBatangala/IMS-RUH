# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (database on the department server)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ruhuna_ims"

# Required. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Also keys the one-time handover/return code hashes. Changing it signs everyone out.
JWT_SECRET=""

# Optional. Session cookies are "Secure" (HTTPS-only) when NODE_ENV=production.
# If the intranet server is reached over plain http://, set COOKIE_SECURE="false"
# (prefer HTTPS with an internal certificate instead).
COOKIE_SECURE=""

# Optional. Enables GET /api/cron/overdue with header "Authorization: Bearer <CRON_SECRET>"
# for a scheduled task. Overdue/expiry checks also run whenever the Requests page loads.
CRON_SECRET=""

# Base URL of the app on the intranet (e.g. http://10.x.x.x:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email via Resend (lib/email.ts). An EXTERNAL service: approved for development testing
# only. Keep EMAIL_ENABLED="false" on the department server until the university approves
# the provider, the sending domain's DNS records and outbound HTTPS to api.resend.com.
# Email is a copy of in-app notifications plus the borrower's handover code; the app works
# fully without it. Every attempt is recorded in the EmailDelivery table.
EMAIL_ENABLED="false"
RESEND_API_KEY=""
# Until a domain is verified in Resend, only "onboarding@resend.dev" works as sender, and
# it only delivers to the Resend account owner's address.
EMAIL_FROM="DEIE Labs <onboarding@resend.dev>"
# Development only (ignored when NODE_ENV=production): redirect ALL emails to this inbox.
EMAIL_TEST_RECIPIENT=""
