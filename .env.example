# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (database on the department server)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ruhuna_ims"

# Required. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Also keys the one-time handover/return code hashes. Changing it signs everyone out.
JWT_SECRET=""

# Optional. Session cookies are "Secure" (HTTPS-only) when NODE_ENV=production.
# If the intranet server is reached over plain http://, set COOKIE_SECURE="false"
# (prefer HTTPS with an internal certificate instead).
COOKIE_SECURE=""

# Optional. Enables GET /api/cron/overdue with header "Authorization: Bearer <CRON_SECRET>"
# for a scheduled task. Overdue/expiry checks also run whenever the Requests page loads.
CRON_SECRET=""

# Base URL of the app on the intranet (e.g. http://10.x.x.x:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NOT USED. Email (Resend) is not approved under the intranet-only constraint (see CLAUDE.md).
# Kept as a placeholder until an approved mail channel is decided.
RESEND_API_KEY=""
